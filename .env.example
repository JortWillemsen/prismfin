# ==============================================================================
# PrismFin Environment Configuration
# ==============================================================================

# Jellyfin Media Server URL
# The public URL to your Jellyfin instance (used by client browsers)
VITE_JELLYFIN_SERVER_URL=http://jellyfin.local:8096

# Optional: Internal backend URL for Nginx proxy (e.g. LAN IP or internal Docker service name)
# Useful when public Jellyfin is behind Cloudflare to avoid Cloudflare proxy loops (Error 1000).
# JELLYFIN_INTERNAL_URL=http://jellyfin.local:8096

# Application Branding
# The client name displayed in the top bar, page title, and media headers
VITE_APP_NAME=PrismFin

# Branding Assets
# Paths to your customized branding assets (relative to /public or absolute URLs)
VITE_APP_LOGO_URL=/assets/branding/logo.png
VITE_APP_ICON_URL=/assets/branding/icon.png
VITE_APP_FAVICON_URL=/assets/branding/favicon.png

# Accent Color
# The primary accent hex color used for highlights, active links, glow effects, and buttons
VITE_APP_ACCENT_COLOR=#06A1DB

# Featured Playlist Name
# Name of the Jellyfin playlist to showcase on the home hero banner (leave empty for auto-detect)
VITE_FEATURED_PLAYLIST_NAME=Featured
